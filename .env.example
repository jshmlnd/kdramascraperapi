PORT=3000
# Optional: override source URL at runtime (else uses api.config.js sourceUrl)
# SOURCE_URL=https://example.com
# Optional: restrict CORS (comma-separated origins, else open). e.g. https://myapp.com
# CORS_ORIGIN=
# Optional: rate limit (defaults: 120 req / 60000 ms per IP)
# RATE_MAX=120
# RATE_WINDOW_MS=60000
# Optional: require token to clear cache (DELETE /cache sends x-cache-token header or ?token=)
# CACHE_CLEAR_TOKEN=
# Optional: short-lived kkey defaults for stream/sub APIs (else pass ?kkey= per request).
# Generate via browser devtools on an episode page (kkeys expire in seconds).
# KISSKH_STREAM_KEY=
# KISSKH_SUB_KEY=
# Optional: server-side kkey cache TTL in seconds (default 45). Sames viewers
# hitting one episode share a mint; pass fresh=1 to bypass a stale key.
# KKEY_CACHE_TTL=45
# Optional: grace period (ms) the minter waits for the sub key after the
# stream key lands before returning a partial result (default 4000).
# KKEY_SUB_GRACE_MS=4000
